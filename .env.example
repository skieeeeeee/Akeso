# ---------------------------------------------------------------------------
# MediKiosk — Phase 1 configuration
#
# Copy to backend/.env (or the repository root) and adjust.
# Every value has a working default for local development except the database
# URL, which must point at a PostgreSQL instance you can reach.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | test
DEBUG=true                       # include technical detail in error responses

# --- Database (required) ---------------------------------------------------
# PostgreSQL only. Create both databases before first run:
#   createdb medikiosk && createdb medikiosk_test
DATABASE_URL=postgresql+psycopg://localhost:5432/medikiosk
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/medikiosk_test
SQL_ECHO=false

# --- Authentication --------------------------------------------------------
# Change this before running anywhere other than a local machine.
JWT_SECRET=dev-only-secret-change-before-any-real-deployment
ACCESS_TOKEN_TTL_MINUTES=720

# --- Mock OTP --------------------------------------------------------------
# No SMS gateway exists in the prototype. With EXPOSE_MOCK_OTP=true the
# generated code is returned by the API and the UI shows it inside an explicit
# "prototype" notice. MUST be false anywhere real patients could sign in.
EXPOSE_MOCK_OTP=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# One code accepted for every mobile number, so a demo needs neither an SMS
# gateway nor reading the code off the screen each time.
#
# This is the single most dangerous setting here: it removes the only thing
# between knowing a phone number and reading that patient's record. Set it to
# "" to restore random six-digit codes. The API logs a warning naming this
# setting at every startup while it is set.
DEV_FIXED_OTP=12345

# --- ABHA ------------------------------------------------------------------
# Mock only. No ABDM network call exists anywhere in this codebase.
ABHA_MOCK_MODE=true

# --- AI provider -----------------------------------------------------------
# "none" | "grok". With "none" the app runs entirely on its deterministic
# engines: rule-based question selection, regex document extraction and a
# template summary. With "grok" those still run first and the model only
# adds to them, so an outage changes quality, never availability.
#
# AI_PROVIDER=grok with an empty AI_API_KEY falls back to "none" with a
# warning. Any other provider name fails loudly at startup.
# The client speaks the OpenAI chat-completions dialect, so any provider that
# does works by changing these three values and nothing else. Vision matters
# here: the model transcribes handwritten prescriptions the local OCR cannot.
#
#   Google Gemini (free tier, no card) — key from aistudio.google.com/apikey:
#     AI_PROVIDER=grok
#     AI_MODEL=gemini-3.1-flash-lite
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
#   On the Gemini free tier the per-day request quota is small — around a
#   dozen calls on the full flash models. The "-lite" models have a much
#   larger allowance and transcribed a handwritten prescription just as
#   accurately, so they are the sensible default. A heavier model reads a
#   messy diagnosis line slightly better if you have the quota for it.
#
#   OpenAI:
#     AI_MODEL=gpt-4o
#     AI_BASE_URL=https://api.openai.com/v1
#
#   x.ai:
#     AI_MODEL=grok-4
#     AI_BASE_URL=https://api.x.ai/v1
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=grok-4
AI_BASE_URL=https://api.x.ai/v1
AI_TIMEOUT_SECONDS=20

# --- Speech (text to speech) -----------------------------------------------
# Reads questions aloud in languages the device has no voice for. Marathi,
# Gujarati and Punjabi commonly have none installed, which is the gap this
# closes; unset, the browser's own synthesiser is used exactly as before.
#
# Key from elevenlabs.io -> Profile -> API Keys. It MUST be created with the
# "Text to Speech" permission enabled, or every request returns 401.
#
# The key stays server-side: the browser calls /api/v1/speech and this
# process proxies it. Never expose it to the client — a Vite build inlines
# anything it can see.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TIMEOUT_SECONDS=30

# --- OCR -------------------------------------------------------------------
# "auto"  : plain text, then local PaddleOCR-via-ONNX, then AI vision
# "local" : plain text + local OCR only (no network at all)
# "ai"    : plain text + AI vision only
# "off"   : store documents without attempting to read them
OCR_PROVIDER=auto
OCR_TIMEOUT_SECONDS=60

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760        # 10 MB
UPLOAD_DIR=backend/var/uploads   # mount a volume here in a deployment

# --- CORS ------------------------------------------------------------------
# JSON array. Only needed when the web app is served from another origin;
# the dev server and the Docker stack both proxy /api, so it can stay default.
CORS_ORIGINS=["http://localhost:5173"]
